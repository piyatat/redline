{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redline.dev/schema/inspector.v1.json",
  "title": "Redline Inspector RPC v1",
  "description": "Length-prefixed JSON request/response over TCP (sim 47164-47169).",
  "definitions": {
    "request": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": ["ping", "hierarchy", "snapshot", "highlight", "startRedline", "attributes", "setAttribute", "measure", "refreshNode", "console"]
        },
        "nodeId": { "type": "string" },
        "nodeIdB": { "type": "string" },
        "attributeKey": { "type": "string" },
        "attributeValue": { "type": "string" },
        "bridge": { "$ref": "bridge.v1.json" }
      }
    },
    "response": {
      "type": "object",
      "required": ["id", "ok"],
      "properties": {
        "id": { "type": "string" },
        "ok": { "type": "boolean" },
        "error": { "type": "string" },
        "hierarchy": { "type": "object" },
        "pngBase64": { "type": "string" },
        "attributes": { "type": "object" },
        "measuredGap": { "type": "object" },
        "refreshHint": { "type": "boolean" }
      }
    }
  }
}
